{
  "name": "street-boys-web",
  "version": "0.1.0",
  "description": "Street Boys \u2014 browser-based Nigerian street-life simulation. Foundation only: no game features yet.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/migrate.mjs --external:pg-native --log-level=warning --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "db:migrate:prod": "node dist/migrate.mjs"
  },
  "repository": "https://github.com/wisdom-technologies-bit/street-boys-web",
  "bugs": {
    "url": "https://github.com/wisdom-technologies-bit/street-boys-web/issues"
  },
  "homepage": "https://github.com/wisdom-technologies-bit/street-boys-web#readme",
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
