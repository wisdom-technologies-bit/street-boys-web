# Environment variable NAMES only. Never put a real value in this file.
#
# Copy to `.env.local` for local development and fill in real values THERE.
# `.env*` is gitignored; `.env.example` is the only env file that is committed.
#
# Rules (AGENTS.md section 7): no secrets in the repo, no personal data in logs.

# ---------------------------------------------------------------------------
# Database — used by the app
# ---------------------------------------------------------------------------

# Postgres connection string. Neon pooled endpoint in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ---------------------------------------------------------------------------
# Database — used only by the integration test harness (`npm run test:db`)
# ---------------------------------------------------------------------------

# A separate database. The harness applies migrations and truncates tables, so
# it must never point at a database with data you care about.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/DATABASE_TEST?sslmode=require

# ---------------------------------------------------------------------------
# Declared in street-boys-docs/templates/.env.example, NOT used by this task.
# Kept here as placeholders so the names exist before the code that needs them.
# ---------------------------------------------------------------------------

# Session cookies (accounts, prompt web-02)
SESSION_SECRET=replace-me

# Phone OTP hashing pepper (accounts, prompt web-02)
OTP_HASH_PEPPER=replace-me

# Server-to-server token the realtime server presents (prompt realtime-01)
REALTIME_SERVICE_TOKEN=replace-me

# Base URL of the web API as seen from the realtime server (prompt realtime-01)
WEB_API_BASE_URL=https://example.invalid

# Base URL of the realtime server as seen from the web app (prompt realtime-01)
REALTIME_BASE_URL=https://example.invalid

# Paystack keys and webhook secret (payments, prompt web-17 — BLOCKED until the
# lawyer review passes, D-129). Unused for now.
PAYSTACK_SECRET_KEY=replace-me
PAYSTACK_PUBLIC_KEY=replace-me
PAYSTACK_WEBHOOK_SECRET=replace-me

# Admin allowlist (admin tools, prompt web-18). Unused for now.
ADMIN_EMAILS=admin@example.invalid

# Error tracking DSN. Unused for now.
ERROR_TRACKING_DSN=
